# Server-only secrets. These are read by the /api/ai gateway
# (Cloudflare Pages Function in production, Vite middleware in dev) and are
# NEVER inlined into the browser bundle. Do not add a VITE_ prefix to them.
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Safe to expose (public identification string sent to the Wikimedia REST API).
VITE_WIKIMEDIA_USER_AGENT=PlantDoc/1.0 (https://plantdoc.app; contact@plantdoc.app)
