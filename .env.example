# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Wikimedia API User-Agent (Wikimedia API is free and does not require a paid token)
# Format: AppName/Version (https://yourwebsite.com; contact@yourdomain.com)
VITE_WIKIMEDIA_USER_AGENT=PlantDoc/1.0 (https://plantdoc.app; contact@plantdoc.app)