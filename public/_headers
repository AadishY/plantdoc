# Cloudflare Pages caching and security headers

# AI gateway responses are per-request and must never be cached or indexed.
/api/ai/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

# Fingerprinted Vite assets can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable, stale-if-error=86400
  X-Content-Type-Options: nosniff

# Root media and icons are not fingerprinted; refresh them periodically.
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400, stale-if-error=604800
  Access-Control-Allow-Origin: *

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400, stale-if-error=604800
  Access-Control-Allow-Origin: *

/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400, stale-if-error=604800
  Access-Control-Allow-Origin: *

/*.jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400, stale-if-error=604800
  Access-Control-Allow-Origin: *

/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400, stale-if-error=604800
  X-Content-Type-Options: nosniff

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Machine-readable metadata should update without requiring a hard refresh.
/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: application/manifest+json

/llms.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: text/plain; charset=utf-8

# SPA HTML is always revalidated so titles, structured data, and new chunks are fresh.
/*
  Cache-Control: public, max-age=0, must-revalidate, stale-if-error=86400
  CDN-Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
